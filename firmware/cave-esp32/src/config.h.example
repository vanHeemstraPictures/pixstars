// Copy this file to src/config.h and fill in your values.
// src/config.h is gitignored so credentials never end up in the repo.
//
// Board: ESP32-S3-DevKitC-1 with ESP32-S3-WROOM-1-N16R8 module
//        (16 MB QIO flash, 8 MB octal PSRAM, addressable RGB LED on GPIO 48)

#pragma once

// WiFi credentials
#define WIFI_SSID     "YOUR_SSID_HERE"
#define WIFI_PASSWORD "YOUR_PASSWORD_HERE"

// OSC server: listen for incoming commands from the Mac Mini on this UDP port.
#define OSC_LISTEN_PORT 8000

// Optional static hostname (mDNS / DHCP hint)
#define DEVICE_HOSTNAME "pixstars-cave"

// Serial baud rate for the debug monitor
#define SERIAL_BAUD 115200

// =========================================================================
// ESP32-S3-WROOM-1-N16R8 cave controller -- full GPIO pin map
// =========================================================================
//
// Module:  ESP32-S3-WROOM-1-N16R8 on ESP32-S3-DevKitC-1
//          16 MB QIO flash, 8 MB OCTAL SPI PSRAM, USB OTG, dual USB-C.
//
// UNAVAILABLE GPIOs on this module / board:
//   GPIO 22-25 : do not exist on ESP32-S3
//   GPIO 26-32 : used internally by the 16 MB octal SPI flash
//   GPIO 33-37 : used internally by the 8 MB octal SPI PSRAM
//   GPIO 19,20 : USB OTG D-/D+ on the DevKitC-1 (USB serial / native USB)
//   GPIO 43,44 : default UART0 TX/RX (USB-UART bridge used by pio monitor)
//
// AVOID FOR CRITICAL OUTPUTS (strapping pins, sampled at reset):
//   GPIO 0   : boot-mode select (must be HIGH at boot for normal flash boot)
//   GPIO 3   : JTAG source select (floats at boot)
//   GPIO 45  : VDD_SPI voltage select
//   GPIO 46  : ROM message print select
//
// FREELY USABLE for project I/O (verified against ESP32-S3 datasheet
// "Pin Definitions" table for the WROOM-1-N16R8 variant):
//   GPIO 1, 2, 4-18, 21, 38-42, 47, 48
//
// Pin map (group related signals on adjacent pins for clean wiring):
//
//   --- Turntable (TMC2209 + Hall origin) on GPIO 4-7 ---
//     GPIO 4   STEP    -> TMC2209 STEP   (FastAccelStepper on S3 uses RMT/
//                                          MCPWM hardware pulse generation;
//                                          any output GPIO is acceptable)
//     GPIO 5   DIR     -> TMC2209 DIR
//     GPIO 6   ENABLE  -> TMC2209 EN     (active LOW; HIGH = motor idle)
//     GPIO 7   HALL    <- SS49E / A3144  (interrupt-capable input; every
//                                          ESP32-S3 GPIO supports GPIO_INT)
//
//   --- AX-12A direction control on GPIO 8 ---
//     GPIO 8   AX12_DIR -> RS-485 / half-duplex direction (TX_EN)
//
//   --- WS2812 LED rings (RMT) on GPIO 9-10 ---
//     GPIO 9   LED_RING_REAR  -> 16-LED ring DIN (via 330R + 1000uF)
//     GPIO 10  LED_RING_FRONT -> 35-LED ring DIN (via 330R + 1000uF)
//
//   --- UART2 to Dynamixel AX-12A (half-duplex, tied via direction GPIO 8) ---
//     GPIO 15  UART2 TX -> AX-12A data line (via 74HC126/buffer)
//     GPIO 16  UART2 RX <- AX-12A data line (via 74HC126/buffer)
//
//   --- UART1 to Pololu Mini Maestro 24ch ---
//     GPIO 17  UART1 TX -> Maestro RX
//     GPIO 18  UART1 RX <- Maestro TX (optional, only for feedback reads)
//
//   --- Onboard status LED ---
//     GPIO 48  STATUS_LED (onboard WS2812; driven via neopixelWrite())
//
// Notes:
//   * UART1 and UART2 on the S3 can be matrix-routed to any GPIO; the
//     choices above are for adjacency/wiring, not silicon constraints.
//   * RMT has 8 channels on the S3 and can drive any output GPIO.
// =========================================================================

// --- Turntable stepper (TMC2209) ---
#define TURNTABLE_STEP_PIN    4   // STEP signal to TMC2209
#define TURNTABLE_DIR_PIN     5   // DIR signal to TMC2209
#define TURNTABLE_ENABLE_PIN  6   // TMC2209 ENABLE (active LOW)
#define TURNTABLE_HALL_PIN    7   // Hall sensor input (origin detect, interrupt)

// --- Dynamixel AX-12A head nod (UART2 half-duplex) ---
#define AX12_DIR_PIN          8       // TX_EN / direction control GPIO
#define AX12_UART_NUM         2       // UART2
#define AX12_TX_PIN           15      // UART2 TX -> AX-12A data line (via buffer)
#define AX12_RX_PIN           16      // UART2 RX <- AX-12A data line (via buffer)
#define AX12_BAUD             1000000 // AX-12A factory default 1 Mbps
#define AX12_ID               1       // Unicast ID of the head nod servo

// --- WS2812 LED rings (RMT-driven) ---
#define LED_RING_REAR_PIN     9   // 16-LED ring (lamp head rear / base)
#define LED_RING_REAR_COUNT   16
#define LED_RING_FRONT_PIN    10  // 35-LED ring (lamp head front)
#define LED_RING_FRONT_COUNT  35

// --- Pololu Mini Maestro 24ch servo controller (UART1) ---
#define MAESTRO_UART_NUM      1   // UART1
#define MAESTRO_TX_PIN        17  // UART1 TX -> Maestro RX
#define MAESTRO_RX_PIN        18  // UART1 RX <- Maestro TX (optional feedback)
#define MAESTRO_BAUD          9600  // Maestro compact-protocol default; 8N1

// --- Onboard status LED (WS2812 on the DevKitC-1) ---
// Status indication uses neopixelWrite() from the Arduino-ESP32 core;
// no extra library required.
#ifndef STATUS_LED_PIN
#define STATUS_LED_PIN 48
#endif
